# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env and fill in your confidential API keys and environment settings.
# DO NOT commit .env or real API keys to GitHub or public repositories.
# ==============================================================================

# Google Gemini API Key (Optional for cloud inference mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Workspace Domain & OAuth Credentials
GOOGLE_WORKSPACE_DOMAIN=example.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_AUTH_MOCK=false

# Application Server Settings
PORT=8000
HOST=127.0.0.1
ALLOW_DEV_SWITCH=false
